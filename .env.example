# ==============================================================================
# Telegram Poll Bot - Environment Configuration Template
# Instructions: Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ==============================================================================

# Telegram Bot Token obtained from @BotFather (e.g. 1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ)
BOT_TOKEN=your_telegram_bot_token_here

# Super Admin / Bot Owner Telegram User IDs (comma separated, e.g. 123456789,987654321)
ADMIN_IDS=your_telegram_user_id_here
SUPER_ADMIN_IDS=your_telegram_user_id_here

# Optional: Global Sponsor/Owner Channel username or ID (e.g. @mychannel or -100123456789)
# Leave empty if you don't want mandatory channel subscription
GLOBAL_FORCE_CHANNEL=

# Database filename (SQLite)
DATABASE_PATH=bot_database.sqlite3
